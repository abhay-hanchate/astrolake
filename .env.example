# ── NASA / Launch Library ──────────────────────────────────────────────────────
# Free key at https://api.nasa.gov/ (DEMO_KEY works but is rate-limited).
# Not required by the current clients (APOD and Exoplanet Archive need no key),
# kept here for forward compatibility with NASA endpoints that do.
NASA_API_KEY=DEMO_KEY

# Optional: raises the Launch Library 2 anonymous rate limit if you have a token.
# LAUNCH_LIBRARY_TOKEN=

# ── Pipeline (Airflow + PySpark, run inside WSL / Linux / macOS) ───────────────
# Absolute path to this project as seen from WSL / Linux.
ASTROLAKE_PROJECT_ROOT=/mnt/c/Users/Admin/Desktop/DEEEEEEEEE/astrolake
# Absolute path to the Python interpreter inside the pipeline virtualenv.
ASTROLAKE_PYTHON_BIN=/home/REPLACE_ME/astrolake-venv/bin/python
